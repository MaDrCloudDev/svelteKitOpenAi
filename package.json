		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.0",
		"svelte": "^5.53.0",
		"svelte-check": "^4.4.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.0",
		"tailwindcss": "^4.2.0"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.0"
		},
